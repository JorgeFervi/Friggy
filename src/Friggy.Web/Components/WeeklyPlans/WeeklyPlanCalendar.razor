@using System.Globalization
@using Friggy.Application.Catalogs.MealTypes.Dtos
@using Friggy.Application.Recipes.Dtos
@using Friggy.Application.WeeklyPlans.Dtos
@using Friggy.Web.WeeklyPlans

<div class="friggy-weekly-calendar" data-testid="weekly-plan-calendar">
    @foreach (var day in Model.Days.OrderBy(day => day.Date))
    {
        var orderedMeals = day.Meals.OrderBy(meal => meal.SlotOrder).ToArray();
        <section class="friggy-weekly-calendar__day"
                 data-testid="weekly-plan-day"
                 aria-label="@DayLabel(day.Date)"
                 @key="day.Date">
            <header class="friggy-weekly-calendar__day-header">
                <p>@day.Date.ToString("dd/MM")</p>
                <h2>@DayLabel(day.Date)</h2>
            </header>
            <div class="friggy-weekly-calendar__meals">
            @foreach (var meal in orderedMeals)
            {
                var selectId = $"meal-{day.Date:yyyyMMdd}-{meal.MealTypeId:N}";
                var isLocked = meal.IsCompleted || meal.Status == MealPlanEntryState.Skipped;
                <article class="friggy-meal-slot" data-testid="meal-slot" data-slot-id="@meal.SlotId" @key="meal.SlotId">
                    <header class="friggy-meal-slot__header">
                    <div class="friggy-meal-slot__title">
                        <strong>@meal.MealTypeName</strong>
                        @if (meal.IsCompleted)
                        {
                            <StatusBadge Tone="FriggyTone.Success">Completada</StatusBadge>
                        }
                        else if (meal.Status == MealPlanEntryState.Skipped)
                        {
                            <StatusBadge Tone="FriggyTone.Warning">Omitida</StatusBadge>
                        }
                        else if (meal.RecipeId.HasValue)
                        {
                            <StatusBadge Tone="FriggyTone.Info">Planificada</StatusBadge>
                        }
                    </div>
                    <div class="friggy-meal-slot__order" aria-label="Orden de @meal.MealTypeName">
                        <button class="friggy-meal-slot__icon-button" type="button"
                                disabled="@(IsSaving || meal.SlotOrder == 0)"
                                aria-label="Subir @meal.MealTypeName"
                                @onclick="() => MoveSlotAsync(day.Date, orderedMeals, meal.SlotId, -1)">↑</button>
                        <button class="friggy-meal-slot__icon-button" type="button"
                                disabled="@(IsSaving || meal.SlotOrder == orderedMeals.Length - 1)"
                                aria-label="Bajar @meal.MealTypeName"
                                @onclick="() => MoveSlotAsync(day.Date, orderedMeals, meal.SlotId, 1)">↓</button>
                        <button class="friggy-meal-slot__remove-slot" type="button"
                                disabled="@(IsSaving || meal.RecipeId.HasValue)"
                                aria-label="Eliminar hueco @meal.MealTypeName"
                                @onclick="() => OnSlotRemoved.InvokeAsync(meal.SlotId)">Eliminar hueco</button>
                    </div>
                    </header>

                    <div class="friggy-meal-slot__fields">
                    <div class="friggy-meal-slot__field friggy-meal-slot__field--recipe">
                    <label for="@selectId">Receta</label>
                    <select id="@selectId"
                            value="@(meal.RecipeId?.ToString() ?? string.Empty)"
                            data-date="@day.Date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)"
                            data-meal-type-id="@meal.MealTypeId"
                            disabled="@(IsSaving || isLocked)"
                            @onchange="args => SelectRecipeAsync(day.Date, meal.MealTypeId, args)">
                        <option value="">Sin receta</option>
                        @foreach (var recipe in Recipes.OrderBy(recipe => recipe.Name, StringComparer.CurrentCultureIgnoreCase))
                        {
                            <option value="@recipe.Id">@recipe.Name</option>
                        }
                    </select>
                    </div>
                    <div class="friggy-meal-slot__field">
                    <label for="@($"{selectId}-time")">Hora prevista</label>
                    <input id="@($"{selectId}-time")"
                           type="time"
                           value="@meal.PlannedTime"
                           disabled="@IsSaving"
                           @onchange="args => OnSlotTimeChanged.InvokeAsync(new(meal.SlotId, args.Value?.ToString()))" />
                    </div>
                    </div>
                    @if (meal.PreparationStartsAt.HasValue)
                    {
                        <p class="friggy-meal-slot__preparation">Empezar preparación: @meal.PreparationStartsAt.Value.ToString("dd/MM/yyyy HH:mm")</p>
                    }

                    @if (!meal.RecipeId.HasValue)
                    {
                        <p class="friggy-meal-slot__empty-state" data-testid="meal-pending">Pendiente de asignar</p>
                    }
                    else
                    {
                        <div class="friggy-meal-slot__field friggy-meal-slot__servings">
                            <label for="@($"{selectId}-servings")">Raciones</label>
                            <input id="@($"{selectId}-servings")"
                                   type="number"
                                   min="1"
                                   value="@meal.Servings"
                                   disabled="@(IsSaving || isLocked)"
                                   @onchange="args => ChangeServingsAsync(day.Date, meal, args)" />
                        </div>
                        @if (meal.IsCompleted)
                        {
                            <p class="friggy-meal-slot__state-copy">Esta comida ya está completada.</p>
                        }
                        else if (meal.Status == MealPlanEntryState.Skipped)
                        {
                            <p class="friggy-meal-slot__state-copy">Omitida: @meal.SkippedReason</p>
                            @if (meal.AlternativeDescription is not null)
                            {
                                <p class="friggy-meal-slot__state-copy">Alternativa: @meal.AlternativeDescription</p>
                            }
                        }
                        else
                        {
                            <div class="friggy-meal-slot__actions" data-testid="meal-actions">
                                <FriggyButton Variant="FriggyButtonVariant.Secondary"
                                              Size="FriggyButtonSize.Compact"
                                              DataAction="toggle-skip"
                                              Disabled="IsSaving"
                                              OnClick="() => ToggleSkipDraft(meal.SlotId)">
                                    Omitir
                                </FriggyButton>
                                <FriggyButton Size="FriggyButtonSize.Compact"
                                              Disabled="IsSaving"
                                              OnClick="() => OnComplete.InvokeAsync(new(day.Date, meal.MealTypeId, meal.RecipeId, meal.Servings))">
                                    Completar
                                </FriggyButton>
                                <button class="friggy-meal-slot__action friggy-meal-slot__action--withdraw" type="button"
                                        data-date="@day.Date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)"
                                        data-meal-type-id="@meal.MealTypeId"
                                        disabled="@(IsSaving || isLocked)"
                                        aria-label="Retirar receta de @meal.MealTypeName del @DayLabel(day.Date)"
                                        @onclick="() => OnChanged.InvokeAsync(new(day.Date, meal.MealTypeId, null, meal.Servings))">
                                    Retirar
                                </button>
                            </div>
                            @if (skipDraftsOpen.Contains(meal.SlotId))
                            {
                                <div class="friggy-meal-slot__skip-fields" data-testid="skip-fields">
                                    <label for="@($"{selectId}-skip-reason")">Motivo para omitir</label>
                                    <input id="@($"{selectId}-skip-reason")"
                                           value="@Draft(meal.SlotId).Reason"
                                           @oninput="args => Draft(meal.SlotId).Reason = args.Value?.ToString()" />
                                    <label for="@($"{selectId}-alternative")">Alternativa</label>
                                    <input id="@($"{selectId}-alternative")"
                                           value="@Draft(meal.SlotId).Alternative"
                                           @oninput="args => Draft(meal.SlotId).Alternative = args.Value?.ToString()" />
                                    <FriggyButton Variant="FriggyButtonVariant.Secondary"
                                                  Size="FriggyButtonSize.Compact"
                                                  Disabled="IsSaving"
                                                  OnClick="() => SkipAsync(day.Date, meal)">Confirmar omisión</FriggyButton>
                                </div>
                            }
                        }
                    }
                </article>
            }
            </div>

            <div class="friggy-weekly-calendar__add-slot">
            <label for="@($"add-slot-{day.Date:yyyyMMdd}")">Añadir tipo de comida</label>
            <div class="friggy-weekly-calendar__add-slot-controls">
                <select id="@($"add-slot-{day.Date:yyyyMMdd}")"
                        data-testid="add-meal-slot"
                        value="@PendingMealTypeValue(day.Date)"
                        disabled="@IsSaving"
                        @onchange="args => SelectMealTypeToAdd(day.Date, args)">
                    <option value="">Selecciona un tipo</option>
                    @foreach (var mealType in MealTypes
                        .Where(item => day.Meals.All(meal => meal.MealTypeId != item.Id))
                        .OrderBy(item => item.Order))
                    {
                        <option value="@mealType.Id">@mealType.Name</option>
                    }
                </select>
                <FriggyButton Variant="FriggyButtonVariant.Secondary"
                              Size="FriggyButtonSize.Compact"
                              DataAction="add-meal-slot"
                              Disabled="@(IsSaving || !pendingMealTypes.ContainsKey(day.Date))"
                              OnClick="() => AddSlotAsync(day.Date)">Añadir</FriggyButton>
            </div>
            </div>
        </section>
    }
</div>

@code {
    private static readonly CultureInfo SpanishCulture = CultureInfo.GetCultureInfo("es-ES");
    private readonly Dictionary<Guid, SkipDraft> skipDrafts = [];
    private readonly HashSet<Guid> skipDraftsOpen = [];
    private readonly Dictionary<DateOnly, Guid> pendingMealTypes = [];

    [Parameter, EditorRequired] public WeeklyPlanResponse Model { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyList<RecipeListItemResponse> Recipes { get; set; } = [];
    [Parameter, EditorRequired] public IReadOnlyList<MealTypeResponse> MealTypes { get; set; } = [];
    [Parameter] public bool IsSaving { get; set; }
    [Parameter] public EventCallback<MealPlanCellChange> OnChanged { get; set; }
    [Parameter] public EventCallback<MealPlanCellChange> OnComplete { get; set; }
    [Parameter] public EventCallback<AddMealPlanSlotChange> OnSlotAdded { get; set; }
    [Parameter] public EventCallback<Guid> OnSlotRemoved { get; set; }
    [Parameter] public EventCallback<ReorderMealPlanSlotsChange> OnSlotsReordered { get; set; }
    [Parameter] public EventCallback<SetMealPlanSlotTimeChange> OnSlotTimeChanged { get; set; }
    [Parameter] public EventCallback<SkipMealPlanEntryChange> OnEntrySkipped { get; set; }

    private async Task SelectRecipeAsync(DateOnly date, Guid mealTypeId, ChangeEventArgs args)
    {
        var recipeId = Guid.TryParse(args.Value?.ToString(), out var parsed) ? parsed : (Guid?)null;
        await OnChanged.InvokeAsync(new(date, mealTypeId, recipeId, 1));
    }

    private async Task ChangeServingsAsync(DateOnly date, WeeklyPlanMealResponse meal, ChangeEventArgs args)
    {
        var servings = int.TryParse(args.Value?.ToString(), out var parsed) && parsed > 0
            ? parsed
            : meal.Servings;
        await OnChanged.InvokeAsync(new(date, meal.MealTypeId, meal.RecipeId, servings));
    }

    private void SelectMealTypeToAdd(DateOnly date, ChangeEventArgs args)
    {
        if (Guid.TryParse(args.Value?.ToString(), out var mealTypeId))
        {
            pendingMealTypes[date] = mealTypeId;
        }
        else
        {
            pendingMealTypes.Remove(date);
        }
    }

    private async Task AddSlotAsync(DateOnly date)
    {
        if (pendingMealTypes.Remove(date, out var mealTypeId))
        {
            await OnSlotAdded.InvokeAsync(new(date, mealTypeId));
        }
    }

    private string PendingMealTypeValue(DateOnly date) =>
        pendingMealTypes.TryGetValue(date, out var mealTypeId) ? mealTypeId.ToString() : string.Empty;

    private void ToggleSkipDraft(Guid slotId)
    {
        if (!skipDraftsOpen.Add(slotId))
        {
            skipDraftsOpen.Remove(slotId);
        }
    }

    private async Task MoveSlotAsync(
        DateOnly date,
        IReadOnlyList<WeeklyPlanMealResponse> meals,
        Guid slotId,
        int offset)
    {
        var ids = meals.Select(meal => meal.SlotId).ToList();
        var current = ids.IndexOf(slotId);
        var target = current + offset;
        if (current < 0 || target < 0 || target >= ids.Count)
        {
            return;
        }

        (ids[current], ids[target]) = (ids[target], ids[current]);
        await OnSlotsReordered.InvokeAsync(new(date, ids));
    }

    private async Task SkipAsync(DateOnly date, WeeklyPlanMealResponse meal)
    {
        var draft = Draft(meal.SlotId);
        await OnEntrySkipped.InvokeAsync(
            new(date, meal.MealTypeId, draft.Reason, draft.Alternative));
    }

    private SkipDraft Draft(Guid slotId)
    {
        if (!skipDrafts.TryGetValue(slotId, out var draft))
        {
            draft = new SkipDraft();
            skipDrafts[slotId] = draft;
        }

        return draft;
    }

    private static string DayLabel(DateOnly date)
    {
        var label = date.ToString("dddd, d 'de' MMMM", SpanishCulture);
        return char.ToUpper(label[0], SpanishCulture) + label[1..];
    }

    private sealed class SkipDraft
    {
        public string? Reason { get; set; }
        public string? Alternative { get; set; }
    }
}
