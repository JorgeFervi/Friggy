<div class="friggy-sidebar-navigation">
    <a class="friggy-sidebar-navigation__brand" href="/" @onclick="HandleNavigateAsync">
        <span class="friggy-sidebar-navigation__mark" aria-hidden="true">F</span>
        <span><strong>Friggy</strong><small>Tu cocina, en orden</small></span>
    </a>
    <nav class="friggy-sidebar-navigation__primary" aria-label="Principal">
        <NavLink href="/" Match="NavLinkMatch.All" @onclick="HandleNavigateAsync"><FriggyIcon Name="FriggyIconName.Home" /><span>Inicio</span></NavLink>
        <NavLink href="/recipes" @onclick="HandleNavigateAsync"><FriggyIcon Name="FriggyIconName.Recipe" /><span>Recetas</span></NavLink>
        <NavLink href="/daily-plans" @onclick="HandleNavigateAsync"><FriggyIcon Name="FriggyIconName.Calendar" /><span>Planes diarios</span></NavLink>
        <NavLink href="/daily-plan-templates" @onclick="HandleNavigateAsync"><FriggyIcon Name="FriggyIconName.Calendar" /><span>Plantillas</span></NavLink>
        <NavLink href="/inventory" @onclick="HandleNavigateAsync"><FriggyIcon Name="FriggyIconName.Inventory" /><span>Inventario</span></NavLink>
    </nav>
    <section class="friggy-sidebar-navigation__catalogs" data-navigation-group="catalogs" aria-labelledby="@CatalogsHeadingId">
        <h2 id="@CatalogsHeadingId">Catálogos</h2>
        <nav aria-label="Catálogos">
            <NavLink href="/ingredients" @onclick="HandleNavigateAsync">Ingredientes</NavLink>
            <NavLink href="/unit-types" @onclick="HandleNavigateAsync">Unidades</NavLink>
            <NavLink href="/recipe-tags" @onclick="HandleNavigateAsync">Etiquetas</NavLink>
            <NavLink href="/meal-types" @onclick="HandleNavigateAsync">Tipos de comida</NavLink>
        </nav>
    </section>
</div>

@code {
    [Parameter] public EventCallback OnNavigate { get; set; }
    [Parameter, EditorRequired] public string IdSuffix { get; set; } = string.Empty;
    private string CatalogsHeadingId => $"catalogs-heading-{IdSuffix}";
    private Task HandleNavigateAsync() => OnNavigate.InvokeAsync();
}
