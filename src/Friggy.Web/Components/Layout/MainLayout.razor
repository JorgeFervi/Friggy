@inherits LayoutComponentBase

<a class="friggy-skip-link" href="#main-content">Saltar al contenido</a>
<AppShell DrawerOpen="drawerOpen" OnMenuClick="OpenDrawer" OnDrawerClose="CloseDrawer">@Body</AppShell>

@if (interactive)
{
    <span data-testid="interactive-ready" hidden aria-hidden="true"></span>
}

<div id="blazor-error-ui" data-nosnippet role="alert">
    <span>Se ha producido un error inesperado.</span>
    <a href="." class="reload">Recargar</a>
    <button type="button" class="dismiss" aria-label="Cerrar aviso">Cerrar</button>
</div>

@code {
    private bool drawerOpen;
    private bool interactive;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            interactive = true;
            StateHasChanged();
        }
    }

    private void OpenDrawer() => drawerOpen = true;
    private void CloseDrawer() => drawerOpen = false;
}
