@page "/ingredients"
@implements IDisposable
@using System.ComponentModel.DataAnnotations
@using Friggy.Application.Catalogs.Ingredients.Dtos
@using Friggy.Web.Api
@inject IIngredientsApiClient Api

<PageTitle>Ingredientes</PageTitle>
<div class="friggy-catalog-page">
    <PageHeader Title="Ingredientes"
                Eyebrow="Catálogo"
                Description="Mantén una lista clara de los alimentos que utilizas en recetas e inventario." />

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <FeedbackPanel Title="No pudimos completar la operación" Tone="FriggyTone.Danger">@error</FeedbackPanel>
    }

    <PageSection Heading="@(editingId.HasValue ? "Editar ingrediente" : "Añadir ingrediente")"
                 Description="Usa un nombre breve y reconocible en toda la aplicación.">
        <EditForm Model="model" OnValidSubmit="SaveAsync" FormName="ingredient-form" class="friggy-catalog-page__form">
            <DataAnnotationsValidator />
            <div class="friggy-catalog-page__fields">
                <div>
                    <label for="ingredient-name">Nombre</label>
                    <InputText id="ingredient-name" @bind-Value="model.Name" />
                    <ValidationMessage For="() => model.Name" />
                </div>
            </div>
            <FormActions>
                <FriggyButton Type="FriggyButtonType.Submit" Busy="saving" BusyLabel="Guardando">
                    @(editingId.HasValue ? "Guardar cambios" : "Añadir")
                </FriggyButton>
                @if (editingId.HasValue)
                {
                    <FriggyButton Variant="FriggyButtonVariant.Secondary" Disabled="saving" OnClick="CancelEdit">
                        Cancelar edición
                    </FriggyButton>
                }
            </FormActions>
        </EditForm>
    </PageSection>

    <PageSection Heading="Ingredientes registrados" Description="Edita nombres o elimina los que ya no necesites.">
        @if (loading)
        {
            <FeedbackPanel Title="Cargando ingredientes" Tone="FriggyTone.Info">Estamos preparando el catálogo.</FeedbackPanel>
        }
        else if (string.IsNullOrWhiteSpace(error) && items.Count == 0)
        {
            <FeedbackPanel Title="No hay ingredientes" Tone="FriggyTone.Neutral">Añade el primero con el formulario anterior.</FeedbackPanel>
        }
        else if (items.Count > 0)
        {
            <div class="friggy-catalog-page__toolbar">
                <div class="friggy-catalog-page__search">
                    <label for="ingredient-search">Buscar por nombre</label>
                    <input id="ingredient-search"
                           type="search"
                           value="@searchTerm"
                           placeholder="Ej. tomate"
                           autocomplete="off"
                           @oninput="SearchChanged" />
                </div>
                <p class="friggy-catalog-page__result-status"
                   data-testid="ingredient-result-status"
                   role="status"
                   aria-live="polite">@ResultSummary</p>
            </div>

            @if (FilteredItemCount == 0)
            {
                <FeedbackPanel Title="Sin coincidencias" Tone="FriggyTone.Neutral">
                    No hay ingredientes cuyo nombre coincida con “@searchTerm”.
                </FeedbackPanel>
            }
            else
            {
                <div class="friggy-catalog-page__cards" role="list">
                    @foreach (var item in PagedItems)
                    {
                        <article class="friggy-catalog-card" role="listitem" @key="item.Id">
                            <h3>@item.Name</h3>
                            <div class="friggy-catalog-page__actions">
                                <FriggyIconButton Label="@($"Editar {item.Name}")" Icon="FriggyIconName.Edit" OnClick="() => BeginEdit(item)" />
                                <FriggyIconButton Label="@($"Borrar {item.Name}")" Icon="FriggyIconName.Delete" Variant="FriggyButtonVariant.Danger" OnClick="() => RequestDelete(item)" />
                            </div>
                        </article>
                    }
                </div>
                <div class="friggy-catalog-page__table">
                    <table>
                        <thead><tr><th>Nombre</th><th><span class="visually-hidden">Acciones</span></th></tr></thead>
                        <tbody>
                        @foreach (var item in PagedItems)
                        {
                            <tr @key="item.Id">
                                <td>@item.Name</td>
                                <td>
                                    <div class="friggy-catalog-page__actions">
                                        <FriggyIconButton Label="@($"Editar {item.Name}")" Icon="FriggyIconName.Edit" OnClick="() => BeginEdit(item)" />
                                        <FriggyIconButton Label="@($"Borrar {item.Name}")" Icon="FriggyIconName.Delete" Variant="FriggyButtonVariant.Danger" OnClick="() => RequestDelete(item)" />
                                    </div>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }

            @if (TotalPages > 1)
            {
                <nav class="friggy-catalog-page__pagination"
                     data-testid="ingredient-pagination"
                     aria-label="Paginación de ingredientes">
                    <FriggyButton Variant="FriggyButtonVariant.Secondary"
                                  Size="FriggyButtonSize.Compact"
                                  AriaLabel="Página anterior"
                                  Disabled="@(currentPage == 1)"
                                  OnClick="PreviousPage">
                        Anterior
                    </FriggyButton>
                    <span data-testid="ingredient-page-status" aria-live="polite">
                        Página @currentPage de @TotalPages
                    </span>
                    <FriggyButton Variant="FriggyButtonVariant.Secondary"
                                  Size="FriggyButtonSize.Compact"
                                  AriaLabel="Página siguiente"
                                  Disabled="@(currentPage == TotalPages)"
                                  OnClick="NextPage">
                        Siguiente
                    </FriggyButton>
                </nav>
            }
        }
    </PageSection>
</div>

@if (itemToDelete is not null)
{
    <ConfirmDialog IsOpen="true"
                   Title="Borrar ingrediente"
                   Message="@($"¿Quieres borrar {itemToDelete.Name}? Esta acción no se puede deshacer.")"
                   ConfirmText="Borrar ingrediente"
                   Busy="deleting"
                   OnConfirm="DeleteAsync"
                   OnCancel="CancelDelete" />
}

@code {
    private const int PageSize = 10;
    private readonly CancellationTokenSource cancellation = new();
    private readonly IngredientInput model = new();
    private IReadOnlyList<IngredientResponse> items = [];
    private IngredientResponse? itemToDelete;
    private Guid? editingId;
    private string? error;
    private bool loading = true;
    private bool saving;
    private bool deleting;
    private string searchTerm = string.Empty;
    private int currentPage = 1;

    private IReadOnlyList<IngredientResponse> FilteredItems =>
        string.IsNullOrWhiteSpace(searchTerm)
            ? items
            : items
                .Where(item => item.Name.Contains(searchTerm.Trim(), StringComparison.OrdinalIgnoreCase))
                .ToArray();

    private IReadOnlyList<IngredientResponse> PagedItems =>
        FilteredItems
            .Skip((currentPage - 1) * PageSize)
            .Take(PageSize)
            .ToArray();

    private int FilteredItemCount => FilteredItems.Count;

    private int TotalPages => Math.Max(1, (FilteredItemCount + PageSize - 1) / PageSize);

    private string ResultSummary
    {
        get
        {
            if (FilteredItemCount == 0)
            {
                return "No se encontraron ingredientes";
            }

            if (FilteredItemCount == 1)
            {
                return "Mostrando 1 de 1 ingrediente";
            }

            var firstItem = ((currentPage - 1) * PageSize) + 1;
            var lastItem = Math.Min(currentPage * PageSize, FilteredItemCount);
            return $"Mostrando {firstItem}-{lastItem} de {FilteredItemCount} ingredientes";
        }
    }

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        try
        {
            items = await Api.ListAsync(cancellation.Token);
            EnsureCurrentPageIsValid();
            error = null;
        }
        catch (Exception exception) when (exception is HttpRequestException or ApiProblemException)
        {
            error = $"No se pudieron cargar los ingredientes: {exception.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task SaveAsync()
    {
        if (saving)
        {
            return;
        }

        saving = true;
        try
        {
            if (editingId is Guid id)
            {
                await Api.UpdateAsync(id, new(model.Name), cancellation.Token);
            }
            else
            {
                await Api.CreateAsync(new(model.Name), cancellation.Token);
            }
            CancelEdit();
            await ReloadAsync();
        }
        catch (Exception exception) when (exception is HttpRequestException or ApiProblemException)
        {
            error = exception.Message;
        }
        finally
        {
            saving = false;
        }
    }

    private void BeginEdit(IngredientResponse item)
    {
        editingId = item.Id;
        model.Name = item.Name;
    }

    private void CancelEdit()
    {
        editingId = null;
        model.Name = string.Empty;
    }

    private void SearchChanged(ChangeEventArgs args)
    {
        searchTerm = args.Value?.ToString() ?? string.Empty;
        currentPage = 1;
    }

    private void PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
        }
    }

    private void NextPage()
    {
        if (currentPage < TotalPages)
        {
            currentPage++;
        }
    }

    private void EnsureCurrentPageIsValid() => currentPage = Math.Min(currentPage, TotalPages);

    private void RequestDelete(IngredientResponse item)
    {
        if (!deleting)
        {
            itemToDelete = item;
        }
    }

    private void CancelDelete() => itemToDelete = null;

    private async Task DeleteAsync()
    {
        var item = itemToDelete;
        if (item is null || deleting)
        {
            return;
        }

        deleting = true;
        try
        {
            await Api.DeleteAsync(item.Id, cancellation.Token);
            await ReloadAsync();
        }
        catch (Exception exception) when (exception is HttpRequestException or ApiProblemException)
        {
            error = exception.Message;
        }
        finally
        {
            deleting = false;
            itemToDelete = null;
        }
    }

    public void Dispose()
    {
        cancellation.Cancel();
        cancellation.Dispose();
        GC.SuppressFinalize(this);
    }

    private sealed class IngredientInput
    {
        [Required(ErrorMessage = "El nombre es obligatorio.")]
        [StringLength(120, ErrorMessage = "El nombre no puede superar 120 caracteres.")]
        public string Name { get; set; } = string.Empty;
    }
}
