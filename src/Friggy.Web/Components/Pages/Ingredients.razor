@page "/ingredients"
@implements IDisposable
@using System.ComponentModel.DataAnnotations
@using Friggy.Application.Catalogs.Ingredients.Dtos
@using Friggy.Web.Api
@inject IIngredientsApiClient Api
@inject IJSRuntime JavaScript

<PageTitle>Ingredientes</PageTitle>
<h1>Ingredientes</h1>

<EditForm Model="model" OnValidSubmit="SaveAsync" FormName="ingredient-form">
    <DataAnnotationsValidator />
    <label for="ingredient-name">Nombre</label>
    <InputText id="ingredient-name" @bind-Value="model.Name" />
    <ValidationMessage For="() => model.Name" />
    <button type="submit">@(editingId.HasValue ? "Guardar" : "Añadir")</button>
    @if (editingId.HasValue)
    {
        <button type="button" @onclick="CancelEdit">Cancelar</button>
    }
</EditForm>

@if (!string.IsNullOrWhiteSpace(error))
{
    <p role="alert">@error</p>
}

@if (loading)
{
    <p>Cargando ingredientes…</p>
}
else if (items.Count == 0)
{
    <p>No hay ingredientes. Añade el primero.</p>
}
else
{
    <table>
        <thead><tr><th>Nombre</th><th>Acciones</th></tr></thead>
        <tbody>
            @foreach (var item in items)
            {
                <tr @key="item.Id">
                    <td>@item.Name</td>
                    <td>
                        <button type="button" @onclick="() => BeginEdit(item)">Editar</button>
                        <button type="button" @onclick="() => DeleteAsync(item)">Borrar</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private readonly CancellationTokenSource cancellation = new();
    private readonly IngredientInput model = new();
    private IReadOnlyList<IngredientResponse> items = [];
    private Guid? editingId;
    private string? error;
    private bool loading = true;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        try
        {
            items = await Api.ListAsync(cancellation.Token);
            error = null;
        }
        catch (Exception exception) when (exception is HttpRequestException or ApiProblemException)
        {
            error = $"No se pudieron cargar los ingredientes: {exception.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task SaveAsync()
    {
        try
        {
            if (editingId is Guid id)
            {
                await Api.UpdateAsync(id, new(model.Name), cancellation.Token);
            }
            else
            {
                await Api.CreateAsync(new(model.Name), cancellation.Token);
            }

            CancelEdit();
            await ReloadAsync();
        }
        catch (ApiProblemException exception)
        {
            error = exception.Message;
        }
    }

    private void BeginEdit(IngredientResponse item)
    {
        editingId = item.Id;
        model.Name = item.Name;
    }

    private void CancelEdit()
    {
        editingId = null;
        model.Name = string.Empty;
    }

    private async Task DeleteAsync(IngredientResponse item)
    {
        if (!await JavaScript.InvokeAsync<bool>("confirm", $"¿Borrar {item.Name}?"))
        {
            return;
        }

        try
        {
            await Api.DeleteAsync(item.Id, cancellation.Token);
            await ReloadAsync();
        }
        catch (ApiProblemException exception)
        {
            error = exception.Message;
        }
    }

    public void Dispose()
    {
        cancellation.Cancel();
        cancellation.Dispose();
        GC.SuppressFinalize(this);
    }

    private sealed class IngredientInput
    {
        [Required(ErrorMessage = "El nombre es obligatorio.")]
        [StringLength(120, ErrorMessage = "El nombre no puede superar 120 caracteres.")]
        public string Name { get; set; } = string.Empty;
    }
}
