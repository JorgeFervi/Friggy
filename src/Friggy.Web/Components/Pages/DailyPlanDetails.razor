@page "/daily-plans/{Date}"
@implements IDisposable
@using System.Globalization
@using Friggy.Application.Catalogs.MealTypes.Dtos
@using Friggy.Application.Catalogs.UnitTypes.Dtos
@using Friggy.Application.DailyPlans.Dtos
@using Friggy.Application.Inventory.Dtos
@using Friggy.Application.Recipes.Dtos
@using Friggy.Web.Api
@using Friggy.Web.Components.DailyPlans
@using Friggy.Web.DailyPlans
@inject IDailyPlansApiClient Api
@inject IRecipesApiClient RecipesApi
@inject IMealTypesApiClient MealTypesApi
@inject IInventoryApiClient LotsApi
@inject IUnitTypesApiClient UnitTypesApi

<PageTitle>Plan diario</PageTitle>
@if (loading)
{
    <PageHeader Title="Plan diario" Eyebrow="Planificación" Description="Cargando el día…" />
}
else if (plan is null)
{
    <PageHeader Title="Plan diario" Eyebrow="Planificación"><Breadcrumb><a href="daily-plans">Volver a planes diarios</a></Breadcrumb></PageHeader>
    <FeedbackPanel Title="@error?.Title" Tone="FriggyTone.Danger"><ChildContent>@error?.Message</ChildContent><Actions><a href="daily-plans">Volver a planes diarios</a></Actions></FeedbackPanel>
}
else
{
    <PageHeader Title="@plan.Date.ToString("dddd, dd/MM/yyyy")" Eyebrow="Planificación diaria"
                Description="Configura las comidas de este único día.">
        <Breadcrumb><a href="daily-plans">Volver a planes diarios</a></Breadcrumb>
    </PageHeader>
    @if (error is not null)
    {
        <FeedbackPanel Title="@error.Title" Tone="FriggyTone.Danger"><ChildContent>@error.Message</ChildContent><Actions>@if (error.CanRetry) { <FriggyButton Variant="FriggyButtonVariant.Secondary" OnClick="ReloadAsync">Reintentar</FriggyButton> }</Actions></FeedbackPanel>
    }
    @if (status is not null)
    {
        <p class="friggy-daily-plan-details__status" role="status">@status</p>
    }
    <PageSection Heading="Comidas" Description="Asigna recetas y comensales, cambia horarios o registra el resultado.">
        <DailyPlanEditor Model="plan" Recipes="recipes" MealTypes="mealTypes" IsSaving="saving"
                         OnChanged="ChangeEntryAsync" OnTimeChanged="SetTimeAsync"
                         OnSlotAdded="AddSlotAsync" OnSlotRemoved="RemoveSlotAsync"
                         OnSlotsReordered="ReorderSlotsAsync" OnSkipped="SkipAsync"
                         OnComplete="CompleteAsync" />
    </PageSection>
    <PageSection Heading="Necesidades del día" Description="Vista provisional del día; la comparación multifecha pertenece a la lista de compra.">
        @if (requirements.Count == 0)
        {
            <FeedbackPanel Title="Sin ingredientes requeridos" Tone="FriggyTone.Neutral">Asigna recetas para calcular las necesidades.</FeedbackPanel>
        }
        else { <QuantityComparison Items="RequirementItems" MissingLabel="Faltante" /> }
    </PageSection>
    @if (mealToComplete is not null)
    {
        <MealCompletionDialog IsOpen="true" Busy="saving" Lots="completionLots" Quantities="completionQuantities" QuantityChanged="SetCompletionQuantity" OnCancel="CancelCompletion" OnConfirm="ConfirmCompletionAsync" />
    }
}

@code {
    private readonly CancellationTokenSource cancellation = new();
    private DailyPlanResponse? plan;
    private IReadOnlyList<RecipeListItemResponse> recipes = [];
    private IReadOnlyList<MealTypeResponse> mealTypes = [];
    private IReadOnlyList<InventoryRequirementResponse> requirements = [];
    private IReadOnlyList<InventoryLotResponse> completionLots = [];
    private readonly Dictionary<Guid, decimal> completionQuantities = [];
    private Guid? mealToComplete;
    private DateOnly plannedDate;
    private UserFacingError? error;
    private string? status;
    private bool loading = true;
    private bool saving;

    private IReadOnlyList<QuantityComparisonItem> RequirementItems => requirements
        .Select(item => new QuantityComparisonItem(item.IngredientName, item.UnitSymbol, item.RequiredQuantity, item.AvailableQuantity, item.MissingQuantity))
        .ToArray();

    [Parameter] public string Date { get; set; } = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        if (!DateOnly.TryParseExact(Date, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out plannedDate))
        {
            error = new UserFacingError("La fecha no es válida", "Vuelve a la lista de planes y elige un día válido.", false);
            loading = false;
            return;
        }

        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        loading = true;
        try
        {
            var planTask = Api.GetAsync(plannedDate, cancellation.Token);
            var recipesTask = RecipesApi.ListAsync(cancellation.Token);
            var mealTypesTask = MealTypesApi.ListAsync(cancellation.Token);
            await Task.WhenAll(planTask, recipesTask, mealTypesTask);
            plan = await planTask;
            recipes = await recipesTask;
            mealTypes = await mealTypesTask;
            requirements = await Api.GetRequirementsAsync(plannedDate, cancellation.Token);
            error = null;
        }
        catch (Exception exception) when (exception is HttpRequestException or ApiProblemException)
        {
            error = UserFacingError.From(exception, "cargar el plan diario");
        }
        finally
        {
            loading = false;
        }
    }

    private Task ChangeEntryAsync(DailyPlanMealChange change) => SaveAsync(async () =>
    {
        plan = change.RecipeId.HasValue
            ? await Api.SetEntryAsync(plannedDate, change.MealTypeId, new(change.RecipeId.Value, change.Servings), cancellation.Token)
            : await Api.RemoveEntryAsync(plannedDate, change.MealTypeId, cancellation.Token);
    });

    private Task SetTimeAsync(DailyPlanSlotTimeChange change) => SaveAsync(async () =>
    {
        await Api.SetSlotTimeAsync(plannedDate, change.SlotId, new(change.PlannedTime), cancellation.Token);
        plan = await Api.GetAsync(plannedDate, cancellation.Token);
    });

    private Task AddSlotAsync(DailyPlanSlotAddChange change) => SaveAsync(async () =>
        plan = await Api.AddSlotAsync(plannedDate, new(change.MealTypeId), cancellation.Token));

    private Task RemoveSlotAsync(Guid slotId) => SaveAsync(async () =>
        plan = await Api.RemoveSlotAsync(plannedDate, slotId, cancellation.Token));

    private Task ReorderSlotsAsync(DailyPlanSlotsOrderChange change) => SaveAsync(async () =>
        plan = await Api.ReorderSlotsAsync(plannedDate, new(change.SlotIds), cancellation.Token));

    private Task SkipAsync(DailyPlanSkipChange change) => SaveAsync(async () =>
    {
        await Api.SkipEntryAsync(plannedDate, change.MealTypeId, new(change.Reason, change.AlternativeDescription), cancellation.Token);
        plan = await Api.GetAsync(plannedDate, cancellation.Token);
    });

    private async Task CompleteAsync(Guid mealTypeId)
    {
        if (plan?.Meals.SingleOrDefault(meal => meal.MealTypeId == mealTypeId)?.RecipeId is not Guid recipeId)
        {
            return;
        }

        saving = true;
        error = null;
        try
        {
            mealToComplete = mealTypeId;
            completionQuantities.Clear();
            var lotsTask = LotsApi.ListAsync(false, cancellation.Token);
            var recipeTask = RecipesApi.GetAsync(recipeId, cancellation.Token);
            var unitsTask = UnitTypesApi.ListAsync(cancellation.Token);
            await Task.WhenAll(lotsTask, recipeTask, unitsTask);
            var recipe = await recipeTask;
            var unitsById = (await unitsTask).ToDictionary(item => item.Id);
            completionLots = (await lotsTask)
                .Where(lot => recipe.Ingredients.Any(required =>
                    required.IngredientId == lot.IngredientId &&
                    AreCompatible(
                        unitsById[required.UnitTypeId],
                        unitsById[lot.UnitTypeId])))
                .ToArray();
        }
        catch (Exception exception) when (exception is HttpRequestException or ApiProblemException)
        {
            CancelCompletion();
            error = UserFacingError.From(exception, "preparar la finalización de la comida");
        }
        finally
        {
            saving = false;
        }
    }

    private void SetCompletionQuantity(MealCompletionQuantityChange change) =>
        completionQuantities[change.LotId] = decimal.TryParse(change.Value, NumberStyles.Number, CultureInfo.GetCultureInfo("es-ES"), out var value)
            ? value
            : 0m;

    private static bool AreCompatible(UnitTypeResponse first, UnitTypeResponse second) =>
        first.MeasurementDimension == second.MeasurementDimension &&
        (first.MeasurementDimension != "unconverted" || first.Id == second.Id);

    private async Task ConfirmCompletionAsync()
    {
        if (mealToComplete is not Guid mealTypeId)
        {
            return;
        }

        saving = true;
        error = null;
        try
        {
            var completion = await Api.CompleteMealAsync(
                plannedDate,
                mealTypeId,
                new CompleteMealRequest(completionQuantities
                    .Where(item => item.Value > 0)
                    .Select(item => new InventoryLotAllocationRequest(item.Key, item.Value))
                    .ToArray()),
                cancellation.Token);
            plan = await Api.GetAsync(plannedDate, cancellation.Token);
            requirements = await Api.GetRequirementsAsync(plannedDate, cancellation.Token);
            status = completion.RemainingRequirements is { Count: > 0 }
                ? "Comida completada. Queda por cubrir: " + string.Join(
                    ", ",
                    completion.RemainingRequirements.Select(item =>
                        $"{item.RemainingQuantity} {item.UnitSymbol} de {item.IngredientName}")) + "."
                : "Comida completada e inventario actualizado.";
            CancelCompletion();
        }
        catch (Exception exception) when (exception is HttpRequestException or ApiProblemException)
        {
            error = UserFacingError.From(exception, "finalizar la comida");
        }
        finally
        {
            saving = false;
        }
    }

    private void CancelCompletion()
    {
        mealToComplete = null;
        completionLots = [];
        completionQuantities.Clear();
    }

    private async Task SaveAsync(Func<Task> operation)
    {
        if (saving) return;
        saving = true;
        error = null;
        try
        {
            await operation();
            requirements = await Api.GetRequirementsAsync(plannedDate, cancellation.Token);
            status = "Cambios guardados.";
        }
        catch (Exception exception) when (exception is HttpRequestException or ApiProblemException)
        {
            error = UserFacingError.From(exception, "guardar el cambio");
        }
        finally
        {
            saving = false;
        }
    }

    public void Dispose()
    {
        cancellation.Cancel();
        cancellation.Dispose();
        GC.SuppressFinalize(this);
    }
}
