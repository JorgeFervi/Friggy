@page "/weekly-plans"
@implements IDisposable
@using Friggy.Application.WeeklyPlans.Dtos
@using Friggy.Web.Api
@using Friggy.Web.WeeklyPlans
@inject IWeeklyPlansApiClient Api
@inject NavigationManager Navigation

<PageTitle>Planes semanales</PageTitle>
<div class="friggy-weekly-plans">
    <PageHeader Title="Planes semanales"
                Eyebrow="Organiza tus comidas"
                Description="Prepara cada semana con calma y ten tus recetas e inventario bajo control." />

    @if (error is not null)
    {
        <FeedbackPanel Title="No pudimos completar la operación" Tone="FriggyTone.Danger">@error</FeedbackPanel>
    }

    <PageSection Heading="Crear un plan"
                 Description="Elige un lunes para construir una semana completa.">
        <EditForm Model="model"
                  OnValidSubmit="CreateAsync"
                  FormName="weekly-plan-create-form"
                  class="friggy-weekly-plans__form"
                  data-testid="weekly-plan-create-form">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="friggy-weekly-plans__fields">
                <div>
                    <label for="weekly-plan-name">Nombre</label>
                    <InputText id="weekly-plan-name" @bind-Value="model.Name" />
                    <ValidationMessage For="() => model.Name" />
                </div>
                <div>
                    <label for="weekly-plan-start-date">Lunes de inicio</label>
                    <InputDate id="weekly-plan-start-date" @bind-Value="model.StartDate" />
                    <ValidationMessage For="() => model.StartDate" />
                </div>
                <div class="friggy-weekly-plans__description">
                    <label for="weekly-plan-description">Descripción</label>
                    <InputTextArea id="weekly-plan-description" @bind-Value="model.Description" />
                </div>
            </div>
            <FormActions>
                <FriggyButton Type="FriggyButtonType.Submit" Busy="saving" BusyLabel="Creando plan">
                    Crear plan
                </FriggyButton>
            </FormActions>
        </EditForm>
    </PageSection>

    <PageSection Heading="Tus semanas" Description="Abre un plan para asignar recetas, horarios y consumos.">
        @if (loading)
        {
            <FeedbackPanel Title="Cargando planes" Tone="FriggyTone.Info">Estamos preparando tus semanas.</FeedbackPanel>
        }
        else if (plans.Count == 0)
        {
            <FeedbackPanel Title="No hay planes semanales" Tone="FriggyTone.Neutral">Crea el primero con el formulario anterior.</FeedbackPanel>
        }
        else
        {
            <div class="friggy-weekly-plans__grid" role="list" data-testid="weekly-plan-list">
                @foreach (var plan in plans)
                {
                    <article class="friggy-weekly-plan-card" role="listitem" @key="plan.Id">
                        <div>
                            <p class="friggy-weekly-plan-card__eyebrow">Semana planificada</p>
                            <h3>@plan.Name</h3>
                            <p>@plan.StartDate.ToString("dd/MM/yyyy") – @plan.EndDate.ToString("dd/MM/yyyy")</p>
                        </div>
                        <div class="friggy-weekly-plan-card__actions">
                            <a href="weekly-plans/@plan.Id">Abrir calendario</a>
                            <FriggyButton Variant="FriggyButtonVariant.Ghost"
                                          Size="FriggyButtonSize.Compact"
                                          DataAction="delete-weekly-plan"
                                          OnClick="() => RequestDelete(plan)">
                                Borrar
                            </FriggyButton>
                        </div>
                    </article>
                }
            </div>
        }
    </PageSection>
</div>

@if (planToDelete is not null)
{
    <ConfirmDialog IsOpen="true"
                   Title="Borrar plan semanal"
                   Message="@($"¿Quieres borrar el plan {planToDelete.Name}? Esta acción no se puede deshacer.")"
                   ConfirmText="Borrar plan"
                   Busy="deleting"
                   OnConfirm="DeleteAsync"
                   OnCancel="CancelDelete" />
}

@code {
    private readonly CancellationTokenSource cancellation = new();
    private WeeklyPlanFormModel model = new();
    private IReadOnlyList<WeeklyPlanListItemResponse> plans = [];
    private WeeklyPlanListItemResponse? planToDelete;
    private string? error;
    private bool loading = true;
    private bool saving;
    private bool deleting;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        try
        {
            plans = await Api.ListAsync(cancellation.Token);
            error = null;
        }
        catch (Exception exception) when (
            exception is HttpRequestException or ApiProblemException)
        {
            error = $"No se pudieron cargar los planes semanales: {exception.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task CreateAsync()
    {
        saving = true;
        error = null;
        try
        {
            var plan = await Api.CreateAsync(model.ToCreateRequest(), cancellation.Token);
            Navigation.NavigateTo($"/weekly-plans/{plan.Id}");
        }
        catch (Exception exception) when (
            exception is HttpRequestException or ApiProblemException)
        {
            error = exception.Message;
        }
        finally
        {
            saving = false;
        }
    }

    private void RequestDelete(WeeklyPlanListItemResponse plan)
    {
        if (!deleting)
        {
            planToDelete = plan;
        }
    }

    private void CancelDelete() => planToDelete = null;

    private async Task DeleteAsync()
    {
        var plan = planToDelete;
        if (plan is null || deleting)
        {
            return;
        }

        deleting = true;

        try
        {
            await Api.DeleteAsync(plan.Id, cancellation.Token);
            plans = plans.Where(item => item.Id != plan.Id).ToArray();
        }
        catch (Exception exception) when (
            exception is HttpRequestException or ApiProblemException)
        {
            error = exception.Message;
        }
        finally
        {
            deleting = false;
            planToDelete = null;
        }
    }

    public void Dispose()
    {
        cancellation.Cancel();
        cancellation.Dispose();
        GC.SuppressFinalize(this);
    }
}
