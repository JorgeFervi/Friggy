@page "/"
@implements IDisposable
@using Friggy.Application.Recipes.Dtos
@using Friggy.Web.Api
@using Friggy.Web.Components.Recipes
@inject IRecipesApiClient RecipesApi

<PageTitle>Friggy</PageTitle>

<div class="friggy-home">
    <PageHeader Title="Tu cocina, organizada"
                Eyebrow="Bienvenido a Friggy"
                Description="Guarda tus recetas, prepara la semana y mantén cada ingrediente bajo control.">
        <Actions><a class="friggy-home__primary-action" href="recipes/new">Crear receta</a></Actions>
    </PageHeader>

    <PageSection Heading="Tus recetas" Description="Platos listos para volver a cocinar y compartir.">
        @if (loading)
        {
            <FeedbackPanel Title="Cargando recetas" Tone="FriggyTone.Info">Estamos preparando tu recetario.</FeedbackPanel>
        }
        else if (error is not null)
        {
            <FeedbackPanel Title="No pudimos cargar las recetas" Tone="FriggyTone.Danger">@error</FeedbackPanel>
        }
        else if (recipes.Count == 0)
        {
            <FeedbackPanel Title="Aún no hay recetas" Tone="FriggyTone.Neutral">
                <ChildContent>Crea tu primera receta para empezar a organizar la cocina.</ChildContent>
                <Actions><a href="recipes/new">Crear la primera receta</a></Actions>
            </FeedbackPanel>
        }
        else
        {
            <RecipeGrid Recipes="recipes" />
        }
    </PageSection>
</div>

@code {
    private readonly CancellationTokenSource cancellation = new();
    private IReadOnlyList<RecipeListItemResponse> recipes = [];
    private string? error;
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            recipes = await RecipesApi.ListAsync(cancellation.Token);
        }
        catch (Exception exception) when (exception is HttpRequestException or ApiProblemException)
        {
            error = exception.Message;
        }
        finally
        {
            loading = false;
        }
    }

    public void Dispose()
    {
        cancellation.Cancel();
        cancellation.Dispose();
        GC.SuppressFinalize(this);
    }
}
