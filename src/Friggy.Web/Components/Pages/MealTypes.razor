@page "/meal-types"
@implements IDisposable
@using System.ComponentModel.DataAnnotations
@using Friggy.Application.Catalogs.MealTypes.Dtos
@using Friggy.Web.Api
@inject IMealTypesApiClient Api

<PageTitle>Tipos de comida</PageTitle>
<div class="friggy-catalog-page">
    <PageHeader Title="Tipos de comida" Eyebrow="Catálogo"
                Description="Configura los momentos del día que organizan tu planificación diaria." />
    @if (error is not null)
    {
        <FeedbackPanel Title="No pudimos completar la operación" Tone="FriggyTone.Danger">@error</FeedbackPanel>
    }
    <PageSection Heading="@(editingId.HasValue ? "Editar tipo de comida" : "Añadir tipo de comida")"
                 Description="El orden determina cómo se muestran las comidas durante el día.">
        <EditForm Model="model" OnValidSubmit="SaveAsync" FormName="meal-form" class="friggy-catalog-page__form">
            <DataAnnotationsValidator />
            <div class="friggy-catalog-page__fields">
                <div>
                    <label for="meal-name">Nombre</label>
                    <InputText id="meal-name" @bind-Value="model.Name" />
                    <ValidationMessage For="() => model.Name" />
                </div>
                <div>
                    <label for="meal-order">Orden</label>
                    <InputNumber id="meal-order" @bind-Value="model.Order" />
                    <ValidationMessage For="() => model.Order" />
                </div>
            </div>
            <FormActions>
                <FriggyButton Type="FriggyButtonType.Submit" Busy="saving" BusyLabel="Guardando">
                    @(editingId.HasValue ? "Guardar cambios" : "Añadir")
                </FriggyButton>
                @if (editingId.HasValue)
                {
                    <FriggyButton Variant="FriggyButtonVariant.Secondary" Disabled="saving" OnClick="CancelEdit">Cancelar edición</FriggyButton>
                }
            </FormActions>
        </EditForm>
    </PageSection>
    <PageSection Heading="Tipos registrados" Description="Revisa el orden antes de editar o eliminar un tipo.">
        @if (loading)
        {
            <FeedbackPanel Title="Cargando tipos de comida" Tone="FriggyTone.Info">Estamos preparando el catálogo.</FeedbackPanel>
        }
        else if (string.IsNullOrWhiteSpace(error) && items.Count == 0)
        {
            <FeedbackPanel Title="No hay tipos de comida" Tone="FriggyTone.Neutral">Añade el primero con el formulario anterior.</FeedbackPanel>
        }
        else if (items.Count > 0)
        {
            <div class="friggy-catalog-page__cards" role="list">
                @foreach (var item in items)
                {
                    <article class="friggy-catalog-card" role="listitem" @key="item.Id">
                        <div><p class="friggy-catalog-card__eyebrow">Orden @item.Order</p><h3>@item.Name</h3></div>
                        <div class="friggy-catalog-page__actions">
                            <FriggyIconButton Label="@($"Editar {item.Name}")" Icon="FriggyIconName.Edit" OnClick="() => BeginEdit(item)" />
                            <FriggyIconButton Label="@($"Borrar {item.Name}")" Icon="FriggyIconName.Delete" Variant="FriggyButtonVariant.Danger" OnClick="() => RequestDelete(item)" />
                        </div>
                    </article>
                }
            </div>
            <div class="friggy-catalog-page__table">
                <table><thead><tr><th>Nombre</th><th>Orden</th><th><span class="visually-hidden">Acciones</span></th></tr></thead><tbody>
                @foreach (var item in items)
                {
                    <tr @key="item.Id"><td>@item.Name</td><td>@item.Order</td><td><div class="friggy-catalog-page__actions">
                        <FriggyIconButton Label="@($"Editar {item.Name}")" Icon="FriggyIconName.Edit" OnClick="() => BeginEdit(item)" />
                        <FriggyIconButton Label="@($"Borrar {item.Name}")" Icon="FriggyIconName.Delete" Variant="FriggyButtonVariant.Danger" OnClick="() => RequestDelete(item)" />
                    </div></td></tr>
                }
                </tbody></table>
            </div>
        }
    </PageSection>
</div>

@if (itemToDelete is not null)
{
    <ConfirmDialog IsOpen="true" Title="Borrar tipo de comida"
                   Message="@($"¿Quieres borrar {itemToDelete.Name}? Esta acción no se puede deshacer.")"
                   ConfirmText="Borrar tipo" Busy="deleting" OnConfirm="DeleteAsync" OnCancel="CancelDelete" />
}

@code {
    private readonly CancellationTokenSource cancellation = new();
    private readonly MealInput model = new();
    private IReadOnlyList<MealTypeResponse> items = [];
    private MealTypeResponse? itemToDelete;
    private Guid? editingId;
    private string? error;
    private bool loading = true;
    private bool saving;
    private bool deleting;
    protected override async Task OnInitializedAsync() => await ReloadAsync();
    private async Task ReloadAsync()
    {
        try { items = await Api.ListAsync(cancellation.Token); error = null; }
        catch (Exception ex) when (ex is HttpRequestException or ApiProblemException) { error = $"No se pudieron cargar los tipos de comida: {ex.Message}"; }
        finally { loading = false; }
    }
    private async Task SaveAsync()
    {
        if (saving) return;
        saving = true;
        try
        {
            if (editingId is Guid id) await Api.UpdateAsync(id, new(model.Name, model.Order), cancellation.Token);
            else await Api.CreateAsync(new(model.Name, model.Order), cancellation.Token);
            CancelEdit();
            await ReloadAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or ApiProblemException) { error = ex.Message; }
        finally { saving = false; }
    }
    private void BeginEdit(MealTypeResponse item) { editingId = item.Id; model.Name = item.Name; model.Order = item.Order; }
    private void CancelEdit() { editingId = null; model.Name = string.Empty; model.Order = 0; }
    private void RequestDelete(MealTypeResponse item) { if (!deleting) itemToDelete = item; }
    private void CancelDelete() => itemToDelete = null;
    private async Task DeleteAsync()
    {
        var item = itemToDelete;
        if (item is null || deleting) return;
        deleting = true;
        try { await Api.DeleteAsync(item.Id, cancellation.Token); await ReloadAsync(); }
        catch (Exception ex) when (ex is HttpRequestException or ApiProblemException) { error = ex.Message; }
        finally { deleting = false; itemToDelete = null; }
    }
    public void Dispose() { cancellation.Cancel(); cancellation.Dispose(); GC.SuppressFinalize(this); }
    private sealed class MealInput
    {
        [Required(ErrorMessage = "El nombre es obligatorio.")]
        [StringLength(120)]
        public string Name { get; set; } = string.Empty;
        [Range(0, int.MaxValue, ErrorMessage = "El orden no puede ser negativo.")]
        public int Order { get; set; }
    }
}
