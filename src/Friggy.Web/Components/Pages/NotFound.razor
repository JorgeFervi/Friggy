@page "/not-found"
@layout MainLayout

<PageTitle>Página no encontrada</PageTitle>
<div class="friggy-secondary-page">
    <PageHeader Title="Página no encontrada"
                Eyebrow="Error 404"
                Description="La dirección puede haber cambiado o el contenido ya no estar disponible." />
    <FriggyCard Heading="Volvamos a una zona conocida">
        <p>Revisa la dirección o regresa al inicio para continuar organizando tu cocina.</p>
        <a class="friggy-secondary-page__action" href="/">Volver al inicio</a>
    </FriggyCard>
</div>
