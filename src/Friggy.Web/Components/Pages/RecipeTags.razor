@page "/recipe-tags"
@using System.ComponentModel.DataAnnotations
@using Friggy.Application.Catalogs.RecipeTags.Dtos
@using Friggy.Web.Api
@inject IRecipeTagsApiClient Api
@inject IJSRuntime JavaScript

<PageTitle>Etiquetas</PageTitle>
<h1>Etiquetas de receta</h1>
<EditForm Model="model" OnValidSubmit="SaveAsync" FormName="tag-form">
    <DataAnnotationsValidator />
    <label for="tag-name">Nombre</label>
    <InputText id="tag-name" @bind-Value="model.Name" />
    <ValidationMessage For="() => model.Name" />
    <button type="submit">@(editingId.HasValue ? "Guardar" : "Añadir")</button>
    @if (editingId.HasValue) { <button type="button" @onclick="CancelEdit">Cancelar</button> }
</EditForm>
@if (error is not null) { <p role="alert">@error</p> }
@if (loading) { <p>Cargando etiquetas…</p> }
else if (items.Count == 0) { <p>No hay etiquetas. Añade la primera.</p> }
else
{
    <table><thead><tr><th>Nombre</th><th>Acciones</th></tr></thead><tbody>
        @foreach (var item in items)
        {
            <tr @key="item.Id"><td>@item.Name</td><td>
                <button type="button" @onclick="() => BeginEdit(item)">Editar</button>
                <button type="button" @onclick="() => DeleteAsync(item)">Borrar</button>
            </td></tr>
        }
    </tbody></table>
}

@code {
    private readonly TagInput model = new();
    private IReadOnlyList<RecipeTagResponse> items = [];
    private Guid? editingId;
    private string? error;
    private bool loading = true;
    protected override async Task OnInitializedAsync() { await ReloadAsync(); loading = false; }
    private async Task ReloadAsync() { try { items = await Api.ListAsync(CancellationToken.None); error = null; } catch (Exception ex) when (ex is HttpRequestException or ApiProblemException) { error = ex.Message; } }
    private async Task SaveAsync() { try { if (editingId is Guid id) await Api.UpdateAsync(id, new(model.Name), CancellationToken.None); else await Api.CreateAsync(new(model.Name), CancellationToken.None); CancelEdit(); await ReloadAsync(); } catch (ApiProblemException ex) { error = ex.Message; } }
    private void BeginEdit(RecipeTagResponse item) { editingId = item.Id; model.Name = item.Name; }
    private void CancelEdit() { editingId = null; model.Name = string.Empty; }
    private async Task DeleteAsync(RecipeTagResponse item) { if (await JavaScript.InvokeAsync<bool>("confirm", $"¿Borrar {item.Name}?")) { try { await Api.DeleteAsync(item.Id, CancellationToken.None); await ReloadAsync(); } catch (ApiProblemException ex) { error = ex.Message; } } }
    private sealed class TagInput { [Required(ErrorMessage = "El nombre es obligatorio.")] [StringLength(120)] public string Name { get; set; } = string.Empty; }
}
