@page "/recipe-tags"
@implements IDisposable
@using System.ComponentModel.DataAnnotations
@using Friggy.Application.Catalogs.RecipeTags.Dtos
@using Friggy.Web.Api
@inject IRecipeTagsApiClient Api

<PageTitle>Etiquetas</PageTitle>
<div class="friggy-catalog-page">
    <PageHeader Title="Etiquetas de receta" Eyebrow="Catálogo"
                Description="Agrupa tus recetas con etiquetas sencillas y fáciles de localizar." />
    @if (error is not null)
    {
        <FeedbackPanel Title="No pudimos completar la operación" Tone="FriggyTone.Danger">@error</FeedbackPanel>
    }
    <PageSection Heading="@(editingId.HasValue ? "Editar etiqueta" : "Añadir etiqueta")"
                 Description="Elige un nombre que describa una categoría útil para ti.">
        <EditForm Model="model" OnValidSubmit="SaveAsync" FormName="tag-form" class="friggy-catalog-page__form">
            <DataAnnotationsValidator />
            <div class="friggy-catalog-page__fields">
                <div>
                    <label for="tag-name">Nombre</label>
                    <InputText id="tag-name" @bind-Value="model.Name" />
                    <ValidationMessage For="() => model.Name" />
                </div>
            </div>
            <FormActions>
                <FriggyButton Type="FriggyButtonType.Submit" Busy="saving" BusyLabel="Guardando">
                    @(editingId.HasValue ? "Guardar cambios" : "Añadir")
                </FriggyButton>
                @if (editingId.HasValue)
                {
                    <FriggyButton Variant="FriggyButtonVariant.Secondary" Disabled="saving" OnClick="CancelEdit">Cancelar edición</FriggyButton>
                }
            </FormActions>
        </EditForm>
    </PageSection>
    <PageSection Heading="Etiquetas registradas" Description="Mantén la clasificación de tus recetas ordenada.">
        @if (loading)
        {
            <FeedbackPanel Title="Cargando etiquetas" Tone="FriggyTone.Info">Estamos preparando el catálogo.</FeedbackPanel>
        }
        else if (string.IsNullOrWhiteSpace(error) && items.Count == 0)
        {
            <FeedbackPanel Title="No hay etiquetas" Tone="FriggyTone.Neutral">Añade la primera con el formulario anterior.</FeedbackPanel>
        }
        else if (items.Count > 0)
        {
            <div class="friggy-catalog-page__cards" role="list">
                @foreach (var item in items)
                {
                    <article class="friggy-catalog-card" role="listitem" @key="item.Id">
                        <h3>@item.Name</h3>
                        <div class="friggy-catalog-page__actions">
                            <FriggyIconButton Label="@($"Editar {item.Name}")" Icon="FriggyIconName.Edit" OnClick="() => BeginEdit(item)" />
                            <FriggyIconButton Label="@($"Borrar {item.Name}")" Icon="FriggyIconName.Delete" Variant="FriggyButtonVariant.Danger" OnClick="() => RequestDelete(item)" />
                        </div>
                    </article>
                }
            </div>
            <div class="friggy-catalog-page__table">
                <table><thead><tr><th>Nombre</th><th><span class="visually-hidden">Acciones</span></th></tr></thead><tbody>
                @foreach (var item in items)
                {
                    <tr @key="item.Id"><td>@item.Name</td><td><div class="friggy-catalog-page__actions">
                        <FriggyIconButton Label="@($"Editar {item.Name}")" Icon="FriggyIconName.Edit" OnClick="() => BeginEdit(item)" />
                        <FriggyIconButton Label="@($"Borrar {item.Name}")" Icon="FriggyIconName.Delete" Variant="FriggyButtonVariant.Danger" OnClick="() => RequestDelete(item)" />
                    </div></td></tr>
                }
                </tbody></table>
            </div>
        }
    </PageSection>
</div>

@if (itemToDelete is not null)
{
    <ConfirmDialog IsOpen="true" Title="Borrar etiqueta"
                   Message="@($"¿Quieres borrar {itemToDelete.Name}? Esta acción no se puede deshacer.")"
                   ConfirmText="Borrar etiqueta" Busy="deleting" OnConfirm="DeleteAsync" OnCancel="CancelDelete" />
}

@code {
    private readonly CancellationTokenSource cancellation = new();
    private readonly TagInput model = new();
    private IReadOnlyList<RecipeTagResponse> items = [];
    private RecipeTagResponse? itemToDelete;
    private Guid? editingId;
    private string? error;
    private bool loading = true;
    private bool saving;
    private bool deleting;
    protected override async Task OnInitializedAsync() => await ReloadAsync();
    private async Task ReloadAsync()
    {
        try { items = await Api.ListAsync(cancellation.Token); error = null; }
        catch (Exception ex) when (ex is HttpRequestException or ApiProblemException) { error = $"No se pudieron cargar las etiquetas: {ex.Message}"; }
        finally { loading = false; }
    }
    private async Task SaveAsync()
    {
        if (saving) return;
        saving = true;
        try
        {
            if (editingId is Guid id) await Api.UpdateAsync(id, new(model.Name), cancellation.Token);
            else await Api.CreateAsync(new(model.Name), cancellation.Token);
            CancelEdit();
            await ReloadAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or ApiProblemException) { error = ex.Message; }
        finally { saving = false; }
    }
    private void BeginEdit(RecipeTagResponse item) { editingId = item.Id; model.Name = item.Name; }
    private void CancelEdit() { editingId = null; model.Name = string.Empty; }
    private void RequestDelete(RecipeTagResponse item) { if (!deleting) itemToDelete = item; }
    private void CancelDelete() => itemToDelete = null;
    private async Task DeleteAsync()
    {
        var item = itemToDelete;
        if (item is null || deleting) return;
        deleting = true;
        try { await Api.DeleteAsync(item.Id, cancellation.Token); await ReloadAsync(); }
        catch (Exception ex) when (ex is HttpRequestException or ApiProblemException) { error = ex.Message; }
        finally { deleting = false; itemToDelete = null; }
    }
    public void Dispose() { cancellation.Cancel(); cancellation.Dispose(); GC.SuppressFinalize(this); }
    private sealed class TagInput
    {
        [Required(ErrorMessage = "El nombre es obligatorio.")]
        [StringLength(120)]
        public string Name { get; set; } = string.Empty;
    }
}
