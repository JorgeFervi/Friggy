@page "/recipes/{Id:guid}"
@implements IDisposable
@using Friggy.Application.Catalogs.Ingredients.Dtos
@using Friggy.Application.Catalogs.MealTypes.Dtos
@using Friggy.Application.Catalogs.RecipeTags.Dtos
@using Friggy.Application.Catalogs.UnitTypes.Dtos
@using Friggy.Application.Recipes.Dtos
@using Friggy.Web.Api
@inject IRecipesApiClient RecipesApi
@inject IIngredientsApiClient IngredientsApi
@inject IUnitTypesApiClient UnitTypesApi
@inject IRecipeTagsApiClient TagsApi
@inject IMealTypesApiClient MealTypesApi

<PageTitle>@(recipe?.Name ?? "Receta")</PageTitle>

@if (loading)
{
    <PageHeader Title="Receta" Eyebrow="Recetario" />
    <FeedbackPanel Title="Cargando receta" Tone="FriggyTone.Info">Estamos preparando todos los detalles.</FeedbackPanel>
}
else if (error is not null)
{
    <PageHeader Title="Receta" Eyebrow="Recetario" />
    <FeedbackPanel Title="No pudimos cargar la receta" Tone="FriggyTone.Danger">@error</FeedbackPanel>
}
else if (recipe is not null)
{
    <div class="friggy-recipe-details">
        <PageHeader Title="@recipe.Name" Eyebrow="Recetario"
                    Description="@($"Tiempo estimado: {recipe.EstimatedMinutes} minutos")">
            <Breadcrumb><a href="recipes">Recetas</a><span aria-hidden="true"> / </span><span>@recipe.Name</span>
            </Breadcrumb>
            <Actions><a class="friggy-recipe-details__edit" href="recipes/@recipe.Id/edit">Editar receta</a></Actions>
            <Metadata>
                @if (recipe.TagIds.Count > 0 || recipe.MealTypeIds.Count > 0)
                {
                    <div class="friggy-recipe-details__badges" role="group" aria-label="Clasificación de la receta">
                        @foreach (var tagId in recipe.TagIds)
                        {
                            <StatusBadge Tone="FriggyTone.Info">@TagName(tagId)</StatusBadge>
                        }
                        @foreach (var mealTypeId in recipe.MealTypeIds)
                        {
                            <StatusBadge Tone="FriggyTone.Neutral">@MealTypeName(mealTypeId)</StatusBadge>
                        }
                    </div>
                }
            </Metadata>
        </PageHeader>

        <div class="friggy-recipe-details__columns">
            <PageSection Heading="Ingredientes" Description="Todo lo necesario antes de empezar.">
                <ul class="friggy-recipe-details__ingredients">
                    @foreach (var item in recipe.Ingredients.OrderBy(item => item.Order))
                    {
                        <li @key="item.Id">@RecipeIngredientLabel(item)</li>
                    }
                </ul>
            </PageSection>

            <PageSection Heading="Pasos" Description="Sigue el orden para completar la preparación.">
                <ol class="friggy-recipe-details__steps">
                    @foreach (var step in recipe.Steps.OrderBy(item => item.Order))
                    {
                        var associatedIngredients = recipe.Ingredients
                            .Where(item => step.RecipeIngredientIds.Contains(item.Id))
                            .OrderBy(item => item.Order)
                            .ToArray();
                        <li @key="step.Id">
                            <div class="friggy-recipe-details__step-copy">
                                <p>@step.Description</p>
                                @if (step.EstimatedMinutes.HasValue)
                                {
                                    <span class="friggy-recipe-details__step-time">@step.EstimatedMinutes min</span>
                                }
                            </div>
                            <h3>Ingredientes</h3>
                            @if (associatedIngredients.Length == 0)
                            {
                                <p data-testid="step-associated-ingredients-empty">
                                    Sin ingredientes asociados.
                                </p>
                            }
                            else
                            {
                                <ul data-testid="step-associated-ingredients">
                                    @foreach (var ingredient in associatedIngredients)
                                    {
                                        <li @key="ingredient.Id">@RecipeIngredientLabel(ingredient)</li>
                                    }
                                </ul>
                            }
                        </li>
                    }
                </ol>
            </PageSection>
        </div>
    </div>
}

@code {
    private readonly CancellationTokenSource cancellation = new();
    private RecipeResponse? recipe;
    private IReadOnlyDictionary<Guid, IngredientResponse> ingredients =
        new Dictionary<Guid, IngredientResponse>();
    private IReadOnlyDictionary<Guid, UnitTypeResponse> unitTypes =
        new Dictionary<Guid, UnitTypeResponse>();
    private IReadOnlyDictionary<Guid, RecipeTagResponse> tags =
        new Dictionary<Guid, RecipeTagResponse>();
    private IReadOnlyDictionary<Guid, MealTypeResponse> mealTypes =
        new Dictionary<Guid, MealTypeResponse>();
    private string? error;
    private bool loading = true;

    [Parameter]
    public Guid Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var recipeTask = RecipesApi.GetAsync(Id, cancellation.Token);
            var ingredientsTask = IngredientsApi.ListAsync(cancellation.Token);
            var unitTypesTask = UnitTypesApi.ListAsync(cancellation.Token);
            var tagsTask = TagsApi.ListAsync(cancellation.Token);
            var mealTypesTask = MealTypesApi.ListAsync(cancellation.Token);

            await Task.WhenAll(recipeTask, ingredientsTask, unitTypesTask, tagsTask, mealTypesTask);
            recipe = await recipeTask;
            ingredients = (await ingredientsTask).ToDictionary(item => item.Id);
            unitTypes = (await unitTypesTask).ToDictionary(item => item.Id);
            tags = (await tagsTask).ToDictionary(item => item.Id);
            mealTypes = (await mealTypesTask).ToDictionary(item => item.Id);
        }
        catch (Exception exception) when (
            exception is HttpRequestException or ApiProblemException)
        {
            error = $"No se pudo cargar la receta: {exception.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private string IngredientName(Guid id) =>
        ingredients.TryGetValue(id, out var ingredient) ? ingredient.Name : "Ingrediente desconocido";

    private string UnitName(Guid id) =>
        unitTypes.TryGetValue(id, out var unitType)
            ? unitType.Name
            : "Unidad desconocida";

    private string RecipeIngredientLabel(RecipeIngredientResponse item) =>
        $"{item.Quantity:N2} {UnitName(item.UnitTypeId)} de {IngredientName(item.IngredientId)}";

    private string TagName(Guid id) =>
        tags.TryGetValue(id, out var tag) ? tag.Name : "Etiqueta desconocida";

    private string MealTypeName(Guid id) =>
        mealTypes.TryGetValue(id, out var mealType) ? mealType.Name : "Tipo desconocido";

    public void Dispose()
    {
        cancellation.Cancel();
        cancellation.Dispose();
        GC.SuppressFinalize(this);
    }
}
