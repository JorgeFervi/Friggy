@page "/Error"
@using System.Diagnostics

<PageTitle>Error</PageTitle>
<div class="friggy-secondary-page">
    <PageHeader Title="Algo no ha salido bien"
                Eyebrow="Error inesperado"
                Description="No hemos podido completar esta solicitud, pero puedes volver a una zona segura." />
    <FriggyCard Heading="Puedes continuar">
        <p>Vuelve al inicio e inténtalo de nuevo. Si el problema continúa, conserva el identificador de solicitud.</p>
        @if (ShowRequestId)
        {
            <p class="friggy-secondary-page__request">
                <strong>Identificador de solicitud:</strong> <code>@RequestId</code>
            </p>
        }
        <a class="friggy-secondary-page__action" href="/">Volver al inicio</a>
    </FriggyCard>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
