@page "/weekly-plans/{Id:guid}"
@implements IDisposable
@using Friggy.Application.Recipes.Dtos
@using Friggy.Application.WeeklyPlans.Dtos
@using Friggy.Application.Inventory.Dtos
@using Friggy.Web.Api
@using Friggy.Web.Components.WeeklyPlans
@using Friggy.Web.WeeklyPlans
@inject IWeeklyPlansApiClient WeeklyPlansApi
@inject IRecipesApiClient RecipesApi
@inject IWeeklyPlanInventoryApiClient InventoryApi
@inject IInventoryApiClient LotsApi

<PageTitle>@(plan?.Name ?? "Plan semanal")</PageTitle>

@if (loading)
{
    <h1>Plan semanal</h1>
    <p>Cargando planificación…</p>
}
else if (plan is null)
{
    <h1>Plan semanal</h1>
    <p role="alert">@(error ?? "No se pudo cargar el plan semanal.")</p>
}
else
{
    <h1>@plan.Name</h1>
    <p>
        Semana del @plan.StartDate.ToString("dd/MM/yyyy")
        al @plan.EndDate.ToString("dd/MM/yyyy")
    </p>
    <p><a href="weekly-plans">Volver a planes semanales</a></p>

    <EditForm Model="editModel"
              OnValidSubmit="UpdateAsync"
              FormName="weekly-plan-edit-form"
              data-testid="weekly-plan-edit-form">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div>
            <label for="weekly-plan-edit-name">Nombre</label>
            <InputText id="weekly-plan-edit-name" @bind-Value="editModel.Name" />
            <ValidationMessage For="() => editModel.Name" />
        </div>
        <div>
            <label for="weekly-plan-edit-description">Descripción</label>
            <InputTextArea id="weekly-plan-edit-description" @bind-Value="editModel.Description" />
        </div>
        <button type="submit" disabled="@saving">@(saving ? "Guardando…" : "Guardar detalles")</button>
    </EditForm>

    @if (error is not null)
    {
        <p role="alert">@error</p>
    }

    @if (status is not null)
    {
        <p role="status">@status</p>
    }

    @if (recipes.Count == 0)
    {
        <p>No hay recetas disponibles. Crea una receta antes de asignarla.</p>
    }

    <WeeklyPlanCalendar Model="plan"
                        Recipes="recipes"
                        IsSaving="saving"
                        OnChanged="ChangeEntryAsync"
                        OnComplete="CompleteMealAsync" />

    <h2>Necesidades de inventario</h2>
    @if (requirements.Count == 0)
    {
        <p>No hay ingredientes requeridos.</p>
    }
    else
    {
        <table>
            <thead><tr><th>Ingrediente</th><th>Requerido</th><th>Disponible</th><th>Faltante</th></tr></thead>
            <tbody>
            @foreach (var requirement in requirements)
            {
                <tr @key="@($"{requirement.IngredientId:N}-{requirement.UnitTypeId:N}")">
                    <td>@requirement.IngredientName</td>
                    <td>@requirement.RequiredQuantity @requirement.UnitSymbol</td>
                    <td>@requirement.AvailableQuantity @requirement.UnitSymbol</td>
                    <td>@requirement.MissingQuantity @requirement.UnitSymbol</td>
                </tr>
            }
            </tbody>
        </table>
    }

    @if (mealToComplete is not null)
    {
        <section aria-label="Seleccionar lotes para completar">
            <h2>Selecciona los consumos</h2>
            @if (completionLots.Count == 0)
            {
                <p>No hay lotes compatibles disponibles. Puedes completar la comida dejando toda la necesidad pendiente.</p>
            }
            @foreach (var candidate in completionLots)
            {
                <div @key="candidate.Id">
                    <label for="@($"completion-{candidate.Id:N}")">
                        @candidate.IngredientName: @candidate.Quantity @candidate.UnitSymbol, caduca @candidate.ExpirationDate.ToString("dd/MM/yyyy")
                    </label>
                    <input id="@($"completion-{candidate.Id:N}")"
                           type="number"
                           min="0"
                           step="0.001"
                           value="@completionQuantities.GetValueOrDefault(candidate.Id)"
                           @onchange="args => SetCompletionQuantity(candidate.Id, args)" />
                </div>
            }
            <button disabled="@saving" @onclick="ConfirmCompletionAsync">Confirmar finalización</button>
            <button disabled="@saving" @onclick="CancelCompletion">Cancelar</button>
        </section>
    }
}

@code {
    private readonly CancellationTokenSource cancellation = new();
    private WeeklyPlanResponse? plan;
    private WeeklyPlanFormModel editModel = new();
    private IReadOnlyList<RecipeListItemResponse> recipes = [];
    private IReadOnlyList<InventoryRequirementResponse> requirements = [];
    private IReadOnlyList<InventoryLotResponse> completionLots = [];
    private readonly Dictionary<Guid, decimal> completionQuantities = [];
    private MealPlanCellChange? mealToComplete;
    private string? error;
    private string? status;
    private bool loading = true;
    private bool saving;

    [Parameter]
    public Guid Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var planTask = WeeklyPlansApi.GetAsync(Id, cancellation.Token);
            var recipesTask = RecipesApi.ListAsync(cancellation.Token);
            var requirementsTask = InventoryApi.GetRequirementsAsync(Id, cancellation.Token);
            await Task.WhenAll(planTask, recipesTask, requirementsTask);
            plan = await planTask;
            recipes = await recipesTask;
            requirements = await requirementsTask;
            editModel = WeeklyPlanFormModel.FromResponse(plan);
        }
        catch (Exception exception) when (
            exception is HttpRequestException or ApiProblemException)
        {
            error = $"No se pudo cargar la planificación: {exception.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task UpdateAsync()
    {
        saving = true;
        error = null;
        status = null;
        try
        {
            plan = await WeeklyPlansApi.UpdateAsync(
                Id,
                editModel.ToUpdateRequest(),
                cancellation.Token);
            editModel = WeeklyPlanFormModel.FromResponse(plan);
        }
        catch (Exception exception) when (
            exception is HttpRequestException or ApiProblemException)
        {
            error = exception.Message;
        }
        finally
        {
            saving = false;
        }
    }

    private async Task ChangeEntryAsync(MealPlanCellChange change)
    {
        saving = true;
        error = null;
        status = null;
        try
        {
            plan = change.RecipeId is Guid recipeId
                ? await WeeklyPlansApi.SetEntryAsync(
                    Id,
                    change.Date,
                    change.MealTypeId,
                    new(recipeId, change.Servings),
                    cancellation.Token)
                : await WeeklyPlansApi.RemoveEntryAsync(
                    Id,
                    change.Date,
                    change.MealTypeId,
                    cancellation.Token);
            requirements = await InventoryApi.GetRequirementsAsync(Id, cancellation.Token);
            status = change.RecipeId.HasValue
                ? "Asignación guardada."
                : "Asignación retirada.";
        }
        catch (Exception exception) when (
            exception is HttpRequestException or ApiProblemException)
        {
            error = exception.Message;
        }
        finally
        {
            saving = false;
        }
    }

    private async Task CompleteMealAsync(MealPlanCellChange change)
    {
        saving = true;
        error = null;
        try
        {
            mealToComplete = change;
            completionQuantities.Clear();
            var lotsTask = LotsApi.ListAsync(false, cancellation.Token);
            var recipeTask = change.RecipeId is Guid recipeId
                ? RecipesApi.GetAsync(recipeId, cancellation.Token)
                : null;
            completionLots = await lotsTask;
            if (recipeTask is not null)
            {
                var recipe = await recipeTask;
                var requiredKeys = recipe.Ingredients
                    .Select(item => (item.IngredientId, item.UnitTypeId))
                    .ToHashSet();
                completionLots = completionLots
                    .Where(lot => requiredKeys.Contains((lot.IngredientId, lot.UnitTypeId)))
                    .ToArray();
            }
        }
        catch (Exception exception) when (exception is HttpRequestException or ApiProblemException)
        {
            mealToComplete = null;
            error = exception.Message;
        }
        finally
        {
            saving = false;
        }
    }

    private void SetCompletionQuantity(Guid lotId, ChangeEventArgs args)
    {
        completionQuantities[lotId] = decimal.TryParse(args.Value?.ToString(), out var value)
            ? value
            : 0m;
    }

    private async Task ConfirmCompletionAsync()
    {
        if (mealToComplete is null)
        {
            return;
        }

        saving = true;
        error = null;
        try
        {
            var completion = await InventoryApi.CompleteMealAsync(
                Id,
                mealToComplete.Date,
                mealToComplete.MealTypeId,
                new(completionQuantities
                    .Where(item => item.Value > 0)
                    .Select(item => new InventoryLotAllocationRequest(item.Key, item.Value))
                    .ToArray()),
                cancellation.Token);
            plan = await WeeklyPlansApi.GetAsync(Id, cancellation.Token);
            requirements = await InventoryApi.GetRequirementsAsync(Id, cancellation.Token);
            status = completion.RemainingRequirements is { Count: > 0 }
                ? "Comida completada. Queda por cubrir: " + string.Join(
                    ", ",
                    completion.RemainingRequirements.Select(item =>
                        $"{item.RemainingQuantity} {item.UnitSymbol} de {item.IngredientName}")) + "."
                : "Comida completada e inventario actualizado.";
            CancelCompletion();
        }
        catch (Exception exception) when (exception is HttpRequestException or ApiProblemException)
        {
            error = exception.Message;
        }
        finally
        {
            saving = false;
        }
    }

    private void CancelCompletion()
    {
        mealToComplete = null;
        completionLots = [];
        completionQuantities.Clear();
    }

    public void Dispose()
    {
        cancellation.Cancel();
        cancellation.Dispose();
        GC.SuppressFinalize(this);
    }
}
