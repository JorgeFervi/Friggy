@page "/weekly-plans/{Id:guid}"
@implements IDisposable
@using Friggy.Application.Recipes.Dtos
@using Friggy.Application.Catalogs.MealTypes.Dtos
@using Friggy.Application.WeeklyPlans.Dtos
@using Friggy.Application.Inventory.Dtos
@using Friggy.Web.Api
@using Friggy.Web.Components.WeeklyPlans
@using Friggy.Web.WeeklyPlans
@inject IWeeklyPlansApiClient WeeklyPlansApi
@inject IRecipesApiClient RecipesApi
@inject IMealTypesApiClient MealTypesApi
@inject IWeeklyPlanInventoryApiClient InventoryApi
@inject IInventoryApiClient LotsApi

<PageTitle>@(plan?.Name ?? "Plan semanal")</PageTitle>

<div class="friggy-weekly-plan-details">
    @if (loading)
    {
        <PageHeader Title="Plan semanal" Eyebrow="Planificación" Description="Cargando tu calendario…" />
        <FeedbackPanel Title="Cargando planificación" Tone="FriggyTone.Info">Estamos preparando la semana.</FeedbackPanel>
    }
    else if (plan is null)
    {
        <PageHeader Title="Plan semanal" Eyebrow="Planificación">
            <Breadcrumb><a href="weekly-plans">Volver a planes semanales</a></Breadcrumb>
        </PageHeader>
        <FeedbackPanel Title="No se pudo cargar el plan" Tone="FriggyTone.Danger">@(error ?? "No se pudo cargar el plan semanal.")</FeedbackPanel>
    }
    else
    {
        <PageHeader Title="@plan.Name"
                    Eyebrow="Planificación semanal"
                    Description="@($"Semana del {plan.StartDate:dd/MM/yyyy} al {plan.EndDate:dd/MM/yyyy}")">
            <Breadcrumb><a href="weekly-plans">Volver a planes semanales</a></Breadcrumb>
        </PageHeader>

        @if (error is not null)
        {
            <FeedbackPanel Title="No pudimos guardar el cambio" Tone="FriggyTone.Danger">@error</FeedbackPanel>
        }
        @if (status is not null)
        {
            <div class="friggy-weekly-plan-details__status" role="status">@status</div>
        }

        <PageSection Heading="Detalles del plan" Description="Actualiza el nombre o añade una nota para esta semana.">
            <EditForm Model="editModel" OnValidSubmit="UpdateAsync" FormName="weekly-plan-edit-form"
                      class="friggy-weekly-plan-details__form" data-testid="weekly-plan-edit-form">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="friggy-weekly-plan-details__fields">
                    <div><label for="weekly-plan-edit-name">Nombre</label><InputText id="weekly-plan-edit-name" @bind-Value="editModel.Name" /><ValidationMessage For="() => editModel.Name" /></div>
                    <div><label for="weekly-plan-edit-description">Descripción</label><InputTextArea id="weekly-plan-edit-description" @bind-Value="editModel.Description" /></div>
                </div>
                <FormActions><FriggyButton Type="FriggyButtonType.Submit" Busy="saving" BusyLabel="Guardando">Guardar detalles</FriggyButton></FormActions>
            </EditForm>
        </PageSection>

        <PageSection Heading="Calendario" Description="Asigna recetas, ajusta horarios y registra lo que ocurre con cada comida.">
            @if (recipes.Count == 0)
            {
                <FeedbackPanel Title="No hay recetas disponibles" Tone="FriggyTone.Warning">Crea una receta antes de asignarla.</FeedbackPanel>
            }
            <WeeklyPlanCalendar Model="plan" Recipes="recipes" MealTypes="mealTypes" IsSaving="saving"
                                OnChanged="ChangeEntryAsync" OnComplete="CompleteMealAsync" OnSlotAdded="AddSlotAsync"
                                OnSlotRemoved="RemoveSlotAsync" OnSlotsReordered="ReorderSlotsAsync"
                                OnSlotTimeChanged="SetSlotTimeAsync" OnEntrySkipped="SkipEntryAsync" />
        </PageSection>

        <PageSection Heading="Necesidades de inventario" Description="Compara lo necesario con las existencias disponibles.">
            @if (requirements.Count == 0)
            {
                <FeedbackPanel Title="Sin ingredientes requeridos" Tone="FriggyTone.Neutral">Asigna recetas para calcular las necesidades.</FeedbackPanel>
            }
            else
            {
                <div class="friggy-requirements-table" role="region" aria-label="Necesidades de inventario" tabindex="0">
                    <table><thead><tr><th>Ingrediente</th><th>Requerido</th><th>Disponible</th><th>Faltante</th></tr></thead><tbody>
                    @foreach (var requirement in requirements)
                    {
                        <tr @key="@($"{requirement.IngredientId:N}-{requirement.UnitTypeId:N}")"><td>@requirement.IngredientName</td><td>@requirement.RequiredQuantity @requirement.UnitSymbol</td><td>@requirement.AvailableQuantity @requirement.UnitSymbol</td><td>@requirement.MissingQuantity @requirement.UnitSymbol</td></tr>
                    }
                    </tbody></table>
                </div>
            }
        </PageSection>

        @if (mealToComplete is not null)
        {
            <div class="friggy-completion-dialog__backdrop">
                <section class="friggy-completion-dialog" role="dialog" aria-modal="true" aria-labelledby="completion-title" aria-describedby="completion-description">
                    <header><p>Actualizar inventario</p><h2 id="completion-title">Selecciona los consumos</h2></header>
                    <p id="completion-description">Indica cuánto quieres consumir de cada lote compatible.</p>
                    @if (completionLots.Count == 0)
                    {
                        <FeedbackPanel Title="No hay lotes compatibles" Tone="FriggyTone.Warning">Puedes completar la comida dejando toda la necesidad pendiente.</FeedbackPanel>
                    }
                    <div class="friggy-completion-dialog__lots">
                    @foreach (var candidate in completionLots)
                    {
                        <div @key="candidate.Id"><label for="@($"completion-{candidate.Id:N}")">@candidate.IngredientName: @candidate.Quantity @candidate.UnitSymbol, caduca @candidate.ExpirationDate.ToString("dd/MM/yyyy")</label><input id="@($"completion-{candidate.Id:N}")" type="number" min="0" step="0.001" value="@completionQuantities.GetValueOrDefault(candidate.Id)" @onchange="args => SetCompletionQuantity(candidate.Id, args)" /></div>
                    }
                    </div>
                    <FormActions>
                        <FriggyButton Variant="FriggyButtonVariant.Secondary" Disabled="saving" OnClick="CancelCompletion">Cancelar</FriggyButton>
                        <FriggyButton Busy="saving" BusyLabel="Finalizando" OnClick="ConfirmCompletionAsync">Confirmar finalización</FriggyButton>
                    </FormActions>
                </section>
            </div>
        }
    }
</div>

@code {
    private readonly CancellationTokenSource cancellation = new();
    private WeeklyPlanResponse? plan;
    private WeeklyPlanFormModel editModel = new();
    private IReadOnlyList<RecipeListItemResponse> recipes = [];
    private IReadOnlyList<MealTypeResponse> mealTypes = [];
    private IReadOnlyList<InventoryRequirementResponse> requirements = [];
    private IReadOnlyList<InventoryLotResponse> completionLots = [];
    private readonly Dictionary<Guid, decimal> completionQuantities = [];
    private MealPlanCellChange? mealToComplete;
    private string? error;
    private string? status;
    private bool loading = true;
    private bool saving;

    [Parameter]
    public Guid Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var planTask = WeeklyPlansApi.GetAsync(Id, cancellation.Token);
            var recipesTask = RecipesApi.ListAsync(cancellation.Token);
            var mealTypesTask = MealTypesApi.ListAsync(cancellation.Token);
            var requirementsTask = InventoryApi.GetRequirementsAsync(Id, cancellation.Token);
            await Task.WhenAll(planTask, recipesTask, mealTypesTask, requirementsTask);
            plan = await planTask;
            recipes = await recipesTask;
            mealTypes = await mealTypesTask;
            requirements = await requirementsTask;
            editModel = WeeklyPlanFormModel.FromResponse(plan);
        }
        catch (Exception exception) when (
            exception is HttpRequestException or ApiProblemException)
        {
            error = $"No se pudo cargar la planificación: {exception.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task UpdateAsync()
    {
        saving = true;
        error = null;
        status = null;
        try
        {
            plan = await WeeklyPlansApi.UpdateAsync(
                Id,
                editModel.ToUpdateRequest(),
                cancellation.Token);
            editModel = WeeklyPlanFormModel.FromResponse(plan);
        }
        catch (Exception exception) when (
            exception is HttpRequestException or ApiProblemException)
        {
            error = exception.Message;
        }
        finally
        {
            saving = false;
        }
    }

    private async Task ChangeEntryAsync(MealPlanCellChange change)
    {
        saving = true;
        error = null;
        status = null;
        try
        {
            plan = change.RecipeId is Guid recipeId
                ? await WeeklyPlansApi.SetEntryAsync(
                    Id,
                    change.Date,
                    change.MealTypeId,
                    new(recipeId, change.Servings),
                    cancellation.Token)
                : await WeeklyPlansApi.RemoveEntryAsync(
                    Id,
                    change.Date,
                    change.MealTypeId,
                    cancellation.Token);
            requirements = await InventoryApi.GetRequirementsAsync(Id, cancellation.Token);
            status = change.RecipeId.HasValue
                ? "Asignación guardada."
                : "Asignación retirada.";
        }
        catch (Exception exception) when (
            exception is HttpRequestException or ApiProblemException)
        {
            error = exception.Message;
        }
        finally
        {
            saving = false;
        }
    }

    private async Task AddSlotAsync(AddMealPlanSlotChange change) =>
        await ChangePlanAsync(
            () => WeeklyPlansApi.AddSlotAsync(
                Id,
                change.Date,
                new(change.MealTypeId),
                cancellation.Token),
            "Hueco añadido.");

    private async Task RemoveSlotAsync(Guid slotId) =>
        await ChangePlanAsync(
            () => WeeklyPlansApi.RemoveSlotAsync(Id, slotId, cancellation.Token),
            "Hueco eliminado.");

    private async Task ReorderSlotsAsync(ReorderMealPlanSlotsChange change) =>
        await ChangePlanAsync(
            () => WeeklyPlansApi.ReorderSlotsAsync(
                Id,
                change.Date,
                new(change.SlotIds),
                cancellation.Token),
            "Orden actualizado.");

    private async Task SetSlotTimeAsync(SetMealPlanSlotTimeChange change)
    {
        await ChangePlanAsync(
            async () =>
            {
                await WeeklyPlansApi.SetSlotTimeAsync(
                    Id,
                    change.SlotId,
                    new(change.PlannedTime),
                    cancellation.Token);
                return await WeeklyPlansApi.GetAsync(Id, cancellation.Token);
            },
            "Hora prevista guardada.");
    }

    private async Task SkipEntryAsync(SkipMealPlanEntryChange change)
    {
        await ChangePlanAsync(
            async () =>
            {
                await WeeklyPlansApi.SkipEntryAsync(
                    Id,
                    change.Date,
                    change.MealTypeId,
                    new(change.Reason, change.AlternativeDescription),
                    cancellation.Token);
                requirements = await InventoryApi.GetRequirementsAsync(Id, cancellation.Token);
                return await WeeklyPlansApi.GetAsync(Id, cancellation.Token);
            },
            "Comida omitida.");
    }

    private async Task ChangePlanAsync(
        Func<Task<WeeklyPlanResponse>> operation,
        string successMessage)
    {
        saving = true;
        error = null;
        status = null;
        try
        {
            plan = await operation();
            status = successMessage;
        }
        catch (Exception exception) when (
            exception is HttpRequestException or ApiProblemException)
        {
            error = exception.Message;
        }
        finally
        {
            saving = false;
        }
    }

    private async Task CompleteMealAsync(MealPlanCellChange change)
    {
        saving = true;
        error = null;
        try
        {
            mealToComplete = change;
            completionQuantities.Clear();
            var lotsTask = LotsApi.ListAsync(false, cancellation.Token);
            var recipeTask = change.RecipeId is Guid recipeId
                ? RecipesApi.GetAsync(recipeId, cancellation.Token)
                : null;
            completionLots = await lotsTask;
            if (recipeTask is not null)
            {
                var recipe = await recipeTask;
                var requiredKeys = recipe.Ingredients
                    .Select(item => (item.IngredientId, item.UnitTypeId))
                    .ToHashSet();
                completionLots = completionLots
                    .Where(lot => requiredKeys.Contains((lot.IngredientId, lot.UnitTypeId)))
                    .ToArray();
            }
        }
        catch (Exception exception) when (exception is HttpRequestException or ApiProblemException)
        {
            mealToComplete = null;
            error = exception.Message;
        }
        finally
        {
            saving = false;
        }
    }

    private void SetCompletionQuantity(Guid lotId, ChangeEventArgs args)
    {
        completionQuantities[lotId] = decimal.TryParse(args.Value?.ToString(), out var value)
            ? value
            : 0m;
    }

    private async Task ConfirmCompletionAsync()
    {
        if (mealToComplete is null)
        {
            return;
        }

        saving = true;
        error = null;
        try
        {
            var completion = await InventoryApi.CompleteMealAsync(
                Id,
                mealToComplete.Date,
                mealToComplete.MealTypeId,
                new(completionQuantities
                    .Where(item => item.Value > 0)
                    .Select(item => new InventoryLotAllocationRequest(item.Key, item.Value))
                    .ToArray()),
                cancellation.Token);
            plan = await WeeklyPlansApi.GetAsync(Id, cancellation.Token);
            requirements = await InventoryApi.GetRequirementsAsync(Id, cancellation.Token);
            status = completion.RemainingRequirements is { Count: > 0 }
                ? "Comida completada. Queda por cubrir: " + string.Join(
                    ", ",
                    completion.RemainingRequirements.Select(item =>
                        $"{item.RemainingQuantity} {item.UnitSymbol} de {item.IngredientName}")) + "."
                : "Comida completada e inventario actualizado.";
            CancelCompletion();
        }
        catch (Exception exception) when (exception is HttpRequestException or ApiProblemException)
        {
            error = exception.Message;
        }
        finally
        {
            saving = false;
        }
    }

    private void CancelCompletion()
    {
        mealToComplete = null;
        completionLots = [];
        completionQuantities.Clear();
    }

    public void Dispose()
    {
        cancellation.Cancel();
        cancellation.Dispose();
        GC.SuppressFinalize(this);
    }
}
